{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vinno:vuls:0.2.0:dataset-manifest",
  "title": "VULS 0.2 Dataset Manifest",
  "description": "Identity and file lock for one dataset snapshot. dataset_version is not the VULS schema version.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "dataset_id",
    "dataset_name",
    "dataset_version",
    "vuls_version",
    "study_ids",
    "subject_count",
    "observation_count",
    "source",
    "licence",
    "publication_status",
    "permitted_uses",
    "limitations",
    "files"
  ],
  "properties": {
    "manifest_version": { "const": "0.2.0" },
    "dataset_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "dataset_name": { "type": "string", "minLength": 1, "maxLength": 256 },
    "dataset_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "vuls_version": { "const": "0.2.0" },
    "study_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
      }
    },
    "subject_count": { "type": "integer", "minimum": 0 },
    "observation_count": { "type": "integer", "minimum": 0 },
    "source": { "type": "string", "minLength": 1, "maxLength": 500 },
    "licence": { "type": ["string", "null"], "minLength": 1, "maxLength": 128 },
    "publication_status": { "enum": ["private", "controlled", "open"] },
    "permitted_uses": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["care_management", "research", "commercial_analysis", "public_redistribution"]
      }
    },
    "limitations": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/file_lock" }
    }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "required": ["publication_status"],
        "properties": { "publication_status": { "const": "open" } }
      },
      "then": {
        "properties": { "licence": { "type": "string", "minLength": 1 } },
        "required": ["licence"]
      }
    }
  ],
  "$defs": {
    "file_lock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "record_id", "revision_id"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(subjects|studies|enrollments|observations)/[A-Za-z0-9._-]+\\.json$"
        },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "record_id": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "minLength": 1, "maxLength": 128 }
          ]
        },
        "revision_id": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "minLength": 1, "maxLength": 128 }
          ]
        }
      }
    }
  }
}
