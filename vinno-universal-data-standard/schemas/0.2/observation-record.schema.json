{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vinno:vuls:0.2.0:observation-record",
  "title": "VULS 0.2 Observation",
  "description": "One observation of one enrolled dog at one time. The dog and the study are referenced by id, not copied into the record.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "vuls_version",
    "record_type",
    "record_id",
    "subject_id",
    "study_id",
    "observation",
    "method",
    "provenance",
    "quality",
    "permission"
  ],
  "properties": {
    "vuls_version": { "const": "0.2.0" },
    "record_type": { "const": "observation" },
    "record_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "subject_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "study_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "observation": { "$ref": "#/$defs/observation" },
    "method": { "$ref": "#/$defs/method" },
    "provenance": { "$ref": "#/$defs/provenance" },
    "quality": { "$ref": "#/$defs/quality" },
    "permission": { "$ref": "#/$defs/permission" },
    "observer": { "$ref": "#/$defs/observer" },
    "revision": { "$ref": "#/$defs/revision" }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "required": ["permission"],
        "properties": {
          "permission": {
            "type": "object",
            "required": ["publication_status"],
            "properties": { "publication_status": { "const": "open" } }
          }
        }
      },
      "then": {
        "properties": {
          "permission": {
            "required": ["licence"],
            "properties": { "licence": { "type": "string", "minLength": 1 } }
          }
        }
      }
    }
  ],
  "$defs": {
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["concept", "value", "observed_at"],
      "properties": {
        "concept": {
          "enum": [
            "activity_duration",
            "body_condition_score",
            "body_weight",
            "food_intake",
            "stool_consistency"
          ]
        },
        "value": {
          "oneOf": [
            { "type": "number" },
            { "type": "string", "maxLength": 2000 },
            { "type": "boolean" },
            { "type": "null" }
          ]
        },
        "unit": { "type": ["string", "null"], "maxLength": 64 },
        "observed_at": { "type": "string", "format": "date-time" },
        "entered_at": {
          "type": ["string", "null"],
          "format": "date-time",
          "description": "When the value was entered. This is the recording time, not the measurement time."
        },
        "scoring_system": { "type": ["string", "null"], "minLength": 1, "maxLength": 128 },
        "quantity_basis": { "enum": ["offered", "consumed", "unspecified"] },
        "observation_period": { "enum": ["day", "week"] }
      }
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method_type"],
      "properties": {
        "method_type": {
          "enum": [
            "direct_measurement",
            "laboratory_assay",
            "clinician_assessment",
            "owner_reported",
            "device_recorded",
            "research_protocol",
            "derived",
            "unknown"
          ]
        },
        "method_name": { "type": ["string", "null"], "maxLength": 256 },
        "instrument": { "type": ["string", "null"], "maxLength": 256 },
        "instrument_detail": { "$ref": "#/$defs/instrument_detail" },
        "assay": { "type": ["string", "null"], "maxLength": 256 },
        "laboratory": { "type": ["string", "null"], "maxLength": 256 },
        "protocol_uri": { "type": ["string", "null"], "format": "uri" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_type"],
      "properties": {
        "source_type": {
          "enum": [
            "owner_reported",
            "clinician_reported",
            "laboratory_reported",
            "research_collected",
            "public_dataset",
            "derived_from_other_record",
            "other"
          ]
        },
        "source_name": { "type": ["string", "null"], "maxLength": 256 },
        "source_record_id": { "type": ["string", "null"], "maxLength": 256 },
        "source_uri": { "type": ["string", "null"], "format": "uri" },
        "collected_at": { "type": ["string", "null"], "format": "date-time" },
        "transformation": { "type": ["string", "null"], "maxLength": 1000 }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["unverified", "source_checked", "reviewed", "flagged", "rejected"] },
        "notes": { "type": ["string", "null"], "maxLength": 1000 },
        "reviewed_by": {
          "type": ["string", "null"],
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "reviewed_at": { "type": ["string", "null"], "format": "date-time" },
        "completeness": { "enum": ["complete", "partial", "unknown"] },
        "flags": {
          "type": "array",
          "items": { "type": "string", "maxLength": 128 },
          "uniqueItems": true
        },
        "review_protocol": { "type": ["string", "null"], "maxLength": 256 }
      }
    },
    "instrument_detail": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["instrument_id"],
      "properties": {
        "instrument_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "instrument_type": { "type": ["string", "null"], "maxLength": 128 },
        "manufacturer": { "type": ["string", "null"], "maxLength": 128 },
        "model": { "type": ["string", "null"], "maxLength": 128 },
        "calibration_status": {
          "enum": ["calibrated", "not_calibrated", "unknown", "not_applicable"]
        },
        "calibration_date": { "type": ["string", "null"], "format": "date" }
      }
    },
    "observer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observer_id"],
      "properties": {
        "observer_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "observer_role": {
          "enum": ["owner", "clinician", "researcher", "device", "unknown"]
        }
      }
    },
    "permission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publication_status", "permitted_uses"],
      "properties": {
        "publication_status": { "enum": ["private", "controlled", "open"] },
        "permitted_uses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "care_management",
              "research",
              "commercial_analysis",
              "public_redistribution"
            ]
          }
        },
        "licence": { "type": ["string", "null"], "maxLength": 128 },
        "permission_reference": { "type": ["string", "null"], "maxLength": 256 },
        "reviewed_at": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision_id",
        "revision_number",
        "revision_type",
        "revision_status",
        "created_at",
        "created_by"
      ],
      "properties": {
        "revision_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "revision_number": { "type": "integer", "minimum": 1 },
        "revision_type": { "enum": ["initial", "correction", "withdrawal"] },
        "previous_revision_id": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
            }
          ]
        },
        "revision_reason": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "minLength": 1, "maxLength": 1000 }
          ]
        },
        "created_at": { "type": "string", "format": "date-time" },
        "created_by": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "revision_status": { "enum": ["current", "superseded", "withdrawn"] }
      }
    }
  }
}
